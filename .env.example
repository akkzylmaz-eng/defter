# ─────────────────────────────────────────────────────────────────────────────
#  Defter. Copy this file to .env.local and fill in what you need.
#
#  Nothing here is required. With no keys the app runs on the fixture book in
#  records/: one freelancer, one tax year, twenty receipts. That is the same
#  data the tests run against.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3004

# ── e-Arşiv / e-SMM ─────────────────────────────────────────────────────────
# Issuing a real serbest meslek makbuzu goes through an integrator. The receipt
# arithmetic in engine/makbuz stays exactly the same; only delivery changes.
EARSIV_USERNAME=
EARSIV_PASSWORD=
EARSIV_TEST_MODE=true

# ── Bank feed ───────────────────────────────────────────────────────────────
# Matching incoming transfers to open receipts is what makes paidOn real
# instead of typed in by hand.
BANK_API_KEY=
BANK_IBAN=

# ── Storage ─────────────────────────────────────────────────────────────────
# Clients, receipts and expenses once you outgrow the fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
